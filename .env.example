# ── Supabase ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App URL (for YouTube WebSub callbacks) ────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── Supadata (YouTube transcript fetching) ────────────
# https://supadata.ai
SUPADATA_API_KEY=your-supadata-api-key

# ── Anthropic (Claude for analysis) ──────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Apify (YouTube clip extraction) ──────────────────
# https://apify.com - get token from Settings > Integrations
APIFY_API_TOKEN=your-apify-api-token

# ── Trigger.dev (background job orchestration) ───────
# https://trigger.dev
TRIGGER_SECRET_KEY=your-trigger-secret-key
