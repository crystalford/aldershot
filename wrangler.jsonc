{
  // Aldershot v0 — Cloudflare Workers config.
  // Fill in the D1 database_id after the one-time setup (see README).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aldershot",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // Surfaces are server-rendered from src/ui/; this directory holds only the
  // genuinely static brand/demo assets (the design's real frames). Thumbnails
  // for the user's OWN footage always come from R2, never from here.
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // Workers AI — Whisper transcribe + long-context reasoning. Model choices
  // and their context-window constraints live in src/models.ts.
  "ai": { "binding": "AI" },

  // R2 — uploads, transcripts, timelines, shorts, rendered cuts.
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "aldershot-media" }
  ],

  // D1 — projects + videos. Create with: wrangler d1 create aldershot
  // then paste the returned id below and run: wrangler d1 migrations apply aldershot --remote
  /*
   * The hourly sweep. Everything that reconciles state in this product runs
   * lazily, on the surface that would otherwise show the lie — which never
   * happens for a user who does not come back. See `scheduled` in src/index.ts.
   */
  "triggers": { "crons": ["17 * * * *"] },

  /*
   * Fonts are imported as binary modules rather than base64 strings, which
   * would have inflated 98KB of woff2 into 130KB of source for nothing. See
   * src/ui/fontfaces.ts.
   */
  /*
   * Sending login links. Cloudflare's own service rather than a third party —
   * 3,000/month included on the Workers Paid plan the containers already
   * require, then $0.35 per thousand. Needs a sending domain onboarded before
   * it can reach anyone but a verified address; see docs/LAUNCH.md.
   */
  "send_email": [{ "name": "EMAIL" }],

  "rules": [{ "type": "Data", "globs": ["**/*.woff2"], "fallthrough": false }],

  "d1_databases": [
    { "binding": "DB", "database_name": "aldershot", "database_id": "TODO" }
  ],

  // Container (ffmpeg) — extracts audio for transcription, and runs the
  // "Enhance audio" denoise/EQ/level/loudnorm pass. Everything else (cuts,
  // captions, reframing, export) renders client-side via ffmpeg.wasm instead.
  // Requires the account on Workers Paid with Containers enabled. Built by the
  // GitHub Action (Docker on the runner).
  "containers": [
    /*
     * HEADROOM. This was 5, against a queue consumer also set to 5, so every
     * queue slot wanted a container at once and a render had nowhere to go —
     * and with sleepAfter at 15m the finished ones held their slots anyway.
     * Twenty videos uploaded together failed six of them on this ceiling.
     *
     * A ceiling, not a reservation: containers bill for the seconds they run,
     * so raising it costs nothing until the work is actually there.
     */
    /*
     * A MACHINE THAT CAN ENCODE VIDEO.
     *
     * There was no instance_type here, so every export in this product ran on
     * Cloudflare's default: `lite` — 1/16 of a vCPU, 256 MiB of memory and 2 GB
     * of disk. That is what the export panel's 1080p and 4K were being asked of.
     * The owner's first export sat on 30% until he gave up, and I told him it
     * was probably a stale deploy. It was a sixteenth of a core.
     *
     * standard-4 is 4 vCPU / 12 GiB / 20 GB. It costs no more for the same
     * export — containers bill per vCPU-second and the encode is the same
     * number of them either way — it simply finishes in a quarter of the time,
     * which makes it CHEAPER on the memory and disk hours it is also billed
     * for. The disk is what lets the container hold a downloaded source
     * instead of re-reading it over the wire for every cut.
     */
    {
      "class_name": "RenderContainer",
      "image": "./container/Dockerfile",
      "name": "aldershot-ffmpeg",
      "max_instances": 12,
      "instance_type": "standard-4"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RENDER", "class_name": "RenderContainer" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RenderContainer"] }
  ],

  // NOTE: there is deliberately no "vars" block here.
  //
  // DEV_LOGIN_EMAIL — which disables authentication — lives in .dev.vars,
  // which `wrangler dev` reads and `wrangler deploy` never uploads. Putting it
  // here would ship it: the deploy publishes this file as written, and one
  // stale line would leave the live site treating every visitor as the owner.
  // The deploy workflow greps for it as a second line of defence.
  //
  // Production secrets are set out of band, never committed:
  //   npx wrangler secret put SESSION_SECRET
  //   npx wrangler secret put RESEND_API_KEY

  // Clip embeddings — powers Threads' semantic clustering (src/embeddings.ts,
  // src/threads.ts) instead of exact-tag-string matching. Unlike Containers/
  // R2/D1, `wrangler deploy` HARD-FAILS if a declared vectorize index doesn't
  // already exist (confirmed live: error code 10159, "index ... was not
  // found") — so this binding must stay commented out, not just optionally
  // absent, until the index is actually created. One-time setup, in order:
  //   1. wrangler vectorize create aldershot-clips --dimensions=1024 --metric=cosine
  //      (needs a token with Vectorize edit permission — not yet granted)
  //   2. THEN uncomment the block below and deploy.
  // Until both of those happen, env.VECTORIZE is simply undefined and
  // threads.ts falls back to the old tag-equality grouping automatically.
  // "vectorize": [
  //   { "binding": "VECTORIZE", "index_name": "aldershot-clips" }
  // ]

  // Job pipeline (04-API-AND-JOBS.md). Long work — reading a source, scoring,
  // rendering — is dispatched as a message rather than run inside the
  // request's waitUntil, which is bounded by the request's own lifetime and
  // cannot carry a six-hour transcribe.
  //
  // The queue exists now (created 2026-09-06), so this is live.
  //
  // It matters more than "long jobs run somewhere nicer": waitUntil is bounded
  // by the request that started it, so extracting the audio from a large drone
  // clip was being killed mid-flight and leaving the job row stuck on
  // "running" with no error. A queue consumer has its own lifetime and its own
  // retries, which is the only way a multi-gigabyte read finishes at all.
  //
  // max_batch_size 1 because these are minutes-long jobs, not messages to
  // amortise. max_concurrency is deliberately BELOW the container ceiling
  // above: the queue must not be able to claim every instance, or a render
  // asked for while a bulk upload is reading has nowhere to run.
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "aldershot-jobs" }],
    "consumers": [
      { "queue": "aldershot-jobs", "max_batch_size": 1, "max_retries": 3, "max_concurrency": 6 }
    ]
  }

  // Later phases: Cron Triggers (Radar), AI Gateway.
}
