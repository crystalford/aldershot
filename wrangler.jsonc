{
  // Aldershot v0 — Cloudflare Workers config.
  // Fill in resource IDs after running the one-time setup (see README).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aldershot",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // Console UI (the Transcript Editor + future surfaces) served as static assets.
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // Workers AI — all model calls (Whisper transcribe, FLUX, Wan I2V, Aura voice).
  "ai": { "binding": "AI" },

  // R2 — every generated asset (stills, animated clips, voiceover, final cuts).
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "aldershot-media" }
  ],

  // D1 — project + shot state. Create with: wrangler d1 create aldershot
  "d1_databases": [
    { "binding": "DB", "database_name": "aldershot", "database_id": "TODO" }
  ],

  // Containers — ffmpeg render for the Transcript Editor export (see container/).
  "containers": [
    {
      "class_name": "RenderContainer",
      "image": "./container/Dockerfile",
      "name": "aldershot-render",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RENDER", "class_name": "RenderContainer" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RenderContainer"] }
  ]

  // Later phases: Cron Triggers (the Radar), Vectorize (trend clustering /
  // style search), AI Gateway (metered video).
}
